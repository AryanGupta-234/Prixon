# Identity
ASSISTANT_NAME=Jarvis
WAKE_WORD=

# LLM: cerebras, groq, or huggingface
# Set as many as you like -- if your preferred one runs out of free quota
# mid-session, the app automatically fails over to the next one that has
# credentials set (order: cerebras, groq, huggingface).
#
# Recommended: Cerebras and Groq both host openai/gpt-oss-120b with a real
# standing free tier (no monthly credit pool to run dry, unlike Hugging
# Face's own $0.10/month allowance). Cerebras's 1M-tokens/day free limit is
# the best fit here since every request sends the full action catalog.
LLM_PROVIDER=cerebras

# Get a free key at https://cloud.cerebras.ai (no card needed)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Get a free key at https://console.groq.com (no card needed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Get a free token at https://huggingface.co/settings/tokens
# Free-tier HF credits are tiny ($0.10/month) -- fine as a third-string
# backup, not as your primary provider.
HF_TOKEN=
HF_MODEL=


# Data
ASSISTANT_DATA_PATH=
TOP_K_CANDIDATES=10
MIN_TFIDF_SCORE=0.03
MIN_NLU_CONFIDENCE=medium
CONTEXT_TURNS=8
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.15

# Voice
TTS_RATE=185
TTS_VOLUME=1.0
MIC_TIMEOUT_SECONDS=6
MIC_PHRASE_TIME_LIMIT=8
