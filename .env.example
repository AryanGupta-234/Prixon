# Identity
ASSISTANT_NAME=Jarvis
WAKE_WORD=

# LLM: ollama, cerebras, groq, or huggingface
# Prixon prefers local Ollama first. Cloud providers remain available as
# fallbacks for difficult requests or when local inference is unavailable.
LLM_PROVIDER=ollama

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT_SECONDS=60

# Get a free key at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hugging Face is a backup/experimentation provider. Its free allowance can
# be exhausted quickly, so it should not be relied upon as the primary brain.
HF_TOKEN=
HF_MODEL=

# Resource-aware local inference
MIN_AVAILABLE_RAM_MB_FOR_LOCAL=2500
MAX_CPU_PERCENT_FOR_LOCAL=90

# System Agent
SYSTEM_POLL_INTERVAL_SECONDS=5
SYSTEM_NETWORK_PROBE_EVERY_N_POLLS=6
ANOMALY_CPU_THRESHOLD_PERCENT=90
ANOMALY_CPU_MIN_DURATION_SECONDS=600
ANOMALY_MEMORY_THRESHOLD_PERCENT=90
ANOMALY_MEMORY_MIN_DURATION_SECONDS=900
ANOMALY_DISK_THRESHOLD_PERCENT=90
ANOMALY_DISK_MIN_DURATION_SECONDS=0
ALERT_COOLDOWN_SECONDS=1800

# Data
ASSISTANT_DATA_PATH=
TOP_K_CANDIDATES=10
MIN_TFIDF_SCORE=0.03
MIN_NLU_CONFIDENCE=medium
CONTEXT_TURNS=8
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.15

# Voice
TTS_RATE=185
TTS_VOLUME=1.0
MIC_TIMEOUT_SECONDS=6
MIC_PHRASE_TIME_LIMIT=8
TTS_VOICE=en-US-AvaNeural
TTS_STREAM_RATE=+5%
TTS_STREAM_PITCH=+0Hz
TTS_STREAM_SAMPLE_RATE=24000
